{
  "name": "onefolder",
  "productName": "OneFolder",
  "version": "1.1.2",
  "description": "A tool for managing your visual library",
  "main": "build/main.bundle.js",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "webpack --watch --config ./webpack.dev.js --progress --color",
    "production": "webpack --config ./webpack.prod.js",
    "start": "electron ./build/main.bundle.js",
    "lint": "eslint src/**/*{ts,tsx} widgets/**/*{ts,tsx} --fix",
    "test": "jest",
    "package": "yarn build && electron-builder",
    "package:portable": "yarn build && electron-builder --win portable",
    "package:appimage": "yarn build && node scripts/prepare-icons.js && electron-builder --linux AppImage",
    "verify:appimage": "node scripts/verify-appimage.js",
    "logo": "ncp ./resources/logo/icns/onefolder-logomark-fc.icns ./build/icon.icns && ncp ./resources/logo/ico/onefolder-logomark-fc-256x256.ico ./build/icon.ico",
    "build": "rimraf dist && yarn production && yarn build:web && yarn logo",
    "convert-backup": "electron scripts/convert-dexie-backup.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:masonry": "cd wasm/wasm-build && cargo run masonry masonry/masonry-scalar && cargo run masonry masonry/masonry-simd -- -C target-feature=+simd128",
    "build:exr": "cd wasm/wasm-build && cargo run exr-decoder exr",
    "build:web": "webpack --config ./webpack.web.js --mode production",
    "dev:web": "webpack --watch --config ./webpack.web.js --mode development --progress --color"
  },
  "build": {
    "appId": "com.onefolder-app.onefolder",
    "productName": "OneFolder",
    "afterSign": "scripts/notarize.js",
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "category": "public.app-category.graphics-design",
      "extraResources": [
        "resources/exiftool/exiftool.pl",
        "resources/exiftool/lib",
        "resources/exiftool/.ExifTool_config"
      ]
    },
    "dmg": {
      "icon": false,
      "sign": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": "x64"
        }
      ],
      "artifactName": "OneFolder-${version}-x86_64.${ext}",
      "executableName": "onefolder",
      "category": "Graphics",
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "StartupWMClass": "OneFolder"
        }
      },
      "extraResources": [
        "resources/exiftool/exiftool.pl",
        "resources/exiftool/lib",
        "resources/exiftool/.ExifTool_config",
        {
          "from": "resources/ffmpeg/linux/ffmpeg",
          "to": "resources/ffmpeg/ffmpeg"
        },
        {
          "from": "resources/ffmpeg/linux/ffprobe",
          "to": "resources/ffmpeg/ffprobe"
        }
      ]
    },
    "win": {
      "executableName": "brave",
      "target": [
        "portable"
      ],
      "extraResources": [
        "resources/exiftool/exiftool.exe",
        "resources/exiftool/.ExifTool_config",
        "resources/ffmpeg/ffmpeg.exe",
        "resources/ffmpeg/ffprobe.exe"
      ]
    },
    "extraResources": [
      "resources/themes",
      {
        "from": "dist-web",
        "to": "dist-web"
      },
      {
        "from": "wasm/packages/exr",
        "to": "wasm/packages/exr"
      }
    ],
    "portable": {
      "artifactName": "brave.${ext}",
      "requestExecutionLevel": "user"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "nodeGypRebuild": false,
    "npmRebuild": true
  },
  "repository": "https://github.com/OneFolderApp/OneFolder",
  "author": "OneFolder",
  "license": "MIT",
  "resolutions": {
    "@babel/traverse": "^7.23.2",
    "@babel/core": "^7.29.6",
    "@babel/helpers": "^7.26.10",
    "@babel/runtime": "^7.26.10",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "braces": "^3.0.3",
    "form-data": "^4.0.6",
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.2",
    "immutable": "^4.3.8",
    "serialize-javascript": "^7.0.5",
    "svgo": "^2.8.1",
    "tmp": "^0.2.6",
    "ws": "^8.21.0",
    "micromatch": "^4.0.8",
    "nanoid": "^3.3.8",
    "postcss": "^8.5.10",
    "protocol-buffers-schema": "^3.6.1",
    "yaml": "^1.10.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.2.0",
    "@svgr/webpack": "^6.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chrome": "^0.2.2",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.1",
    "@types/jest": "^29.5.1",
    "@types/offscreencanvas": "^2019.6.2",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/react-window": "^1.8.5",
    "@types/utif": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.52.0",
    "css-loader": "^6.7.3",
    "electron": "41.7.2",
    "electron-builder": "26.15.2",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fake-indexeddb": "^4.0.1",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^30.4.1",
    "mini-css-extract-plugin": "^2.7.2",
    "ncp": "^2.0.0",
    "node-loader": "^2.0.0",
    "normalize.css": "^8.0.1",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^2.8.4",
    "rimraf": "^4.1.2",
    "sass": "^1.58.1",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.1",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "@floating-ui/core": "^1.2.1",
    "@floating-ui/react-dom": "^1.3.0",
    "@logion/node-exiftool": "^2.3.1",
    "@recogito/annotorious": "^2.7.13",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.14.0",
    "@types/mapbox-gl": "^2.7.19",
    "@types/sharp": "^0.32.0",
    "ag-psd": "^15.0.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^3.5.3",
    "comlink": "^4.4.1",
    "copy-webpack-plugin": "^11.0.0",
    "dexie": "^3.2.3",
    "dexie-export-import": "^1.0.3",
    "express": "^5.2.1",
    "fs-extra": "^11.1.0",
    "geo-coordinates-parser": "^1.6.3",
    "libheif-js": "^1.17.1",
    "mapbox-gl": "^3.0.1",
    "mobx": "^6.8.0",
    "mobx-react-lite": "^3.4.0",
    "node-stream-zip": "^1.15.0",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "react-json-view": "^1.21.3",
    "react-virtuoso": "^4.13.0",
    "react-window": "^1.8.8",
    "sharp": "^0.35.2",
    "sourcemapped-stacktrace": "^1.1.11",
    "utif": "^3.1.0",
    "wasm-feature-detect": "^1.2.11"
  }
}
